---
import "../styles/globals.css";
import TopBar from "../components/top-bar.astro";
import Footer from "../components/footer.astro";
import { SITE_DESCRIPTION, SITE_NAME, jsonLdGraph } from "../lib/seo";

type Props = {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  // Extra JSON-LD nodes merged into the site-wide Person + WebSite graph
  schema?: Record<string, unknown>[];
};

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/images/og.png",
  imageAlt = "Daksh Agrawal, AI Engineer and Data Engineer in Melbourne and Udaipur",
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Daksh Agrawal" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#fbf8f1" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:locale:alternate" content="en_IN" />
    {type === "profile" && (
      <>
        <meta property="profile:first_name" content="Daksh" />
        <meta property="profile:last_name" content="Agrawal" />
      </>
    )}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdGraph(schema))} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <Fragment set:html={import.meta.env.HEADER_INJECT} />
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-background text-foreground font-quicksand">
    <TopBar />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Fragment set:html={import.meta.env.FOOTER_INJECT} />
  </body>
</html>
