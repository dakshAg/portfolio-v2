---
/** Comic starburst with a word in it. */
interface Props {
  text: string;
  color?: string;
  class?: string;
  size?: number;
}
const { text, color = "var(--yellow)", class: cls = "", size = 120 } = Astro.props;
const pts: string[] = [];
const n = 14;
for (let i = 0; i < n * 2; i++) {
  const r = i % 2 === 0 ? 50 : 36;
  const a = (Math.PI * 2 * i) / (n * 2) - Math.PI / 2;
  pts.push(`${50 + r * Math.cos(a)},${50 + r * Math.sin(a)}`);
}
---
<span class:list={["relative inline-grid place-items-center", cls]} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full" style="filter: drop-shadow(4px 4px 0 var(--ink))">
    <polygon points={pts.join(" ")} fill={color} stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
  </svg>
  <span class="relative font-display uppercase tracking-wider text-ink" style={`font-size:${size * 0.2}px; transform: rotate(-8deg)`}>{text}</span>
</span>
