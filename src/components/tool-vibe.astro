---
/** Per-tool ambient scene for the tech stack cards. Matched by tool name. */
interface Props { name: string }
const { name } = Astro.props;
const n = name.toLowerCase();
const kind =
  n.includes("cloudflare") ? "clouds" :
  n.includes("hono") ? "fire" :
  n.includes("polars") ? "bear" :
  n.includes("pandas") ? "panda" :
  n.includes("spark") ? "sparks" :
  n.includes("supabase") ? "bolt" :
  n.includes("next") ? "routes" :
  n.includes("github") ? "commits" :
  n.includes("deepnote") ? "cells" :
  n.includes("hex") ? "hexes" :
  n.includes("pytorch") ? "descent" :
  n.includes("fastapi") ? "speed" :
  n.includes("n8n") ? "nodes" :
  n.includes("flutter") ? "wings" :
  n.includes("android") ? "gradle" :
  n.includes("django") ? "pony" :
  n.includes("docker") ? "whale" :
  n.includes("tensorflow") ? "tensors" :
  n.includes("power bi") ? "loading" :
  n.includes("mysql") ? "dolphin" : null;
---
{kind && (
<div class:list={["vibe tv", `tv-${kind}`]} aria-hidden="true">
  {kind === "clouds" && (
    <>
      {[0, 1, 2].map((i) => (
        <svg class="cloud" viewBox="0 0 120 60" style={`--d:${-i * 7}s; --dur:${16 + i * 5}s; top:${10 + i * 26}%; --s:${0.7 + i * 0.25}`}>
          <path d="M20 50 a14 14 0 0 1 4 -27 a18 18 0 0 1 34 -6 a14 14 0 0 1 26 8 a12 12 0 0 1 14 25 z" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
        </svg>
      ))}
      <svg class="zap" viewBox="0 0 30 60"><path d="M18 2 L4 32 h10 L10 58 L27 24 h-11 z" fill="#f6821f" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" /></svg>
    </>
  )}
  {kind === "fire" && (
    <>
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <svg class="flame" viewBox="0 0 40 60" style={`left:${8 + i * 16}%; --d:${(i * 0.17) % 1}s; --h:${0.7 + ((i * 7) % 4) * 0.12}`}>
          <path d="M20 58 C4 48 4 30 20 4 C22 22 34 24 34 40 C34 50 28 58 20 58 z" fill="#ff5a1f" stroke="var(--ink)" stroke-width="2.5" />
          <path d="M20 58 C12 50 12 40 20 28 C22 38 28 40 28 48 C28 54 24 58 20 58 z" fill="var(--yellow)" />
        </svg>
      ))}
      {[0, 1, 2, 3, 4].map((i) => <i class="ember" style={`left:${15 + i * 18}%; --d:${i * 0.4}s`}></i>)}
    </>
  )}
  {kind === "bear" && (
    <>
      {Array.from({ length: 10 }, (_, i) => <i class="flake" style={`left:${i * 10 + 3}%; --d:${(i * 0.9) % 5}s; --dur:${5 + (i % 3)}s`}></i>)}
      <svg class="floe" viewBox="0 0 160 30"><path d="M4 12 L30 4 L70 8 L110 2 L150 10 L156 22 L120 28 L60 26 L10 26 z" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" /></svg>
      <svg class="bear" viewBox="0 0 90 60">
        <ellipse cx="45" cy="38" rx="30" ry="18" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
        <rect x="22" y="44" width="10" height="14" rx="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" class="leg a" />
        <rect x="56" y="44" width="10" height="14" rx="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" class="leg b" />
        <g class="head">
          <circle cx="72" cy="26" r="13" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
          <circle cx="64" cy="16" r="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
          <circle cx="79" cy="15" r="4" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
          <circle cx="69" cy="25" r="1.8" fill="var(--ink)" />
          <circle cx="82" cy="28" r="3" fill="var(--ink)" />
        </g>
      </svg>
    </>
  )}
  {kind === "panda" && (
    <>
      {[0, 1, 2].map((i) => <i class="bamboo" style={`left:${70 + i * 9}%; --h:${60 + i * 25}%; --d:${i * 0.4}s`}></i>)}
      <svg class="panda" viewBox="0 0 80 70">
        <ellipse cx="18" cy="14" rx="10" ry="10" fill="var(--ink)" />
        <ellipse cx="62" cy="14" rx="10" ry="10" fill="var(--ink)" />
        <ellipse cx="40" cy="38" rx="32" ry="28" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
        <ellipse cx="27" cy="34" rx="9" ry="11" fill="var(--ink)" transform="rotate(-15 27 34)" />
        <ellipse cx="53" cy="34" rx="9" ry="11" fill="var(--ink)" transform="rotate(15 53 34)" />
        <circle cx="29" cy="35" r="3" fill="var(--paper)" class="eye" /><circle cx="51" cy="35" r="3" fill="var(--paper)" class="eye" />
        <ellipse cx="40" cy="48" rx="5" ry="3.5" fill="var(--ink)" />
        <path d="M34 55 q6 5 12 0" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round" />
      </svg>
    </>
  )}
  {kind === "sparks" && (
    <svg viewBox="0 0 200 100" preserveAspectRatio="none" style="inset:0;width:100%;height:100%">
      {[0, 1, 2, 3].map((i) => (
        <polyline class="arc" points={`${10 + i * 50},${20 + (i % 2) * 50} ${30 + i * 50},${45} ${20 + i * 50},${55} ${50 + i * 50},${30 + (i % 2) * 40} ${40 + i * 50},${75}`} fill="none" stroke="#e25a1c" stroke-width="3" stroke-linejoin="round" style={`--d:${i * 0.35}s`} />
      ))}
      {Array.from({ length: 8 }, (_, i) => <circle class="spark" cx={20 + i * 24} cy={30 + (i % 3) * 20} r="3" fill="var(--yellow)" stroke="var(--ink)" stroke-width="1.5" style={`--d:${i * 0.22}s`} />)}
    </svg>
  )}
  {kind === "bolt" && (
    <>
      <svg class="cyl" viewBox="0 0 80 100">
        <path d="M10 20 v60 a30 10 0 0 0 60 0 v-60" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
        <rect class="fill" x="10" y="20" width="60" height="60" fill="#3ecf8e" />
        <ellipse cx="40" cy="20" rx="30" ry="10" fill="var(--paper)" stroke="var(--ink)" stroke-width="3" />
        <ellipse cx="40" cy="50" rx="30" ry="10" fill="none" stroke="var(--ink)" stroke-width="2" stroke-dasharray="4 4" />
      </svg>
      <svg class="sbolt" viewBox="0 0 40 70"><path d="M24 2 L4 40 h14 L14 68 L36 28 h-14 z" fill="#3ecf8e" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" /></svg>
    </>
  )}
  {kind === "routes" && (
    <>
      {["/", "/api", "/app", "/[slug]", "/404"].map((r, i) => <span class="route" style={`top:${10 + i * 18}%; --d:${i * 0.9}s`}>{r} <b>200</b></span>)}
      <svg class="tri" viewBox="0 0 60 60"><path d="M30 6 L56 54 H4 z" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linejoin="round" /></svg>
    </>
  )}
  {kind === "commits" && (
    <svg viewBox="0 0 200 100" preserveAspectRatio="none" style="inset:0;width:100%;height:100%;opacity:0.9">
      <path class="branch" d="M20 80 H180" stroke="var(--ink)" stroke-width="3" fill="none" />
      <path class="branch b" d="M60 80 C80 80 80 30 100 30 H140 C160 30 160 80 180 80" stroke="var(--pink)" stroke-width="3" fill="none" />
      {[20, 60, 100, 140, 180].map((x, i) => <circle class="commit" cx={x} cy={i === 2 || i === 3 ? 30 : 80} r="6" fill="var(--lime)" stroke="var(--ink)" stroke-width="3" style={`--d:${i * 0.4}s`} />)}
      <text x="96" y="20" font-family="JetBrains Mono" font-size="9" fill="var(--ink)" class="lbl">feat/ship-it</text>
    </svg>
  )}
  {kind === "cells" && (
    <>
      {[0, 1, 2].map((i) => (
        <div class="cell" style={`--i:${2 - i}; --d:${i * 1.3}s`}>
          <span class="prompt">In [{i + 1}]:</span>
          <span class="code">{["df.groupby('x')", "model.fit(X, y)", "plot(df) ✓"][i]}</span>
          <i class="run"></i>
        </div>
      ))}
    </>
  )}
  {kind === "hexes" && (
    <svg viewBox="0 0 200 110" preserveAspectRatio="xMidYMid slice" style="inset:0;width:100%;height:100%">
      {Array.from({ length: 12 }, (_, i) => {
        const col = i % 4, row = Math.floor(i / 4);
        const x = 30 + col * 46 + (row % 2) * 23, y = 20 + row * 40;
        return <polygon class="hex" points={`${x},${y - 22} ${x + 19},${y - 11} ${x + 19},${y + 11} ${x},${y + 22} ${x - 19},${y + 11} ${x - 19},${y - 11}`} fill="#f5c518" stroke="var(--ink)" stroke-width="2.5" style={`--d:${(i * 0.27) % 2.4}s`} />;
      })}
    </svg>
  )}
  {kind === "descent" && (
    <svg viewBox="0 0 200 100" preserveAspectRatio="none" style="inset:0;width:100%;height:100%">
      <path id="loss" d="M10 20 C60 20 70 90 100 90 C130 90 150 40 190 20" fill="none" stroke="var(--ink)" stroke-width="3" stroke-dasharray="6 5" />
      <circle class="ball" r="8" fill="#ee4c2c" stroke="var(--ink)" stroke-width="3">
        <animateMotion dur="3.2s" repeatCount="indefinite" keyPoints="0;0.5;0.42;0.5;0.47;0.5" keyTimes="0;0.45;0.6;0.75;0.88;1" calcMode="linear"><mpath href="#loss" /></animateMotion>
      </circle>
      <text x="100" y="75" text-anchor="middle" font-family="JetBrains Mono" font-size="9" fill="var(--ink)">loss ↓</text>
    </svg>
  )}
  {kind === "speed" && (
    <>
      {Array.from({ length: 7 }, (_, i) => <i class="line" style={`top:${8 + i * 13}%; --d:${(i * 0.13) % 0.9}s; --w:${30 + ((i * 37) % 50)}%`}></i>)}
      <svg class="dash" viewBox="0 0 60 60"><path d="M36 4 L10 34 h16 L22 56 L50 24 h-16 z" fill="#009688" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" /></svg>
    </>
  )}
  {kind === "nodes" && (
    <svg viewBox="0 0 200 100" preserveAspectRatio="none" style="inset:0;width:100%;height:100%">
      <path class="wire" d="M30 50 H80 M80 50 C110 50 110 25 140 25 M80 50 C110 50 110 75 140 75" fill="none" stroke="var(--ink)" stroke-width="2.5" />
      {[[30, 50], [80, 50], [140, 25], [140, 75]].map(([x, y], i) => <rect class="node" x={x - 12} y={y - 10} width="24" height="20" rx="4" fill="#ff6d5a" stroke="var(--ink)" stroke-width="2.5" style={`--d:${i * 0.5}s`} />)}
      <circle class="pulse" r="4" fill="var(--yellow)" stroke="var(--ink)" stroke-width="2"><animateMotion dur="2.4s" repeatCount="indefinite" path="M30 50 H80 C110 50 110 25 140 25" /></circle>
      <circle class="pulse" r="4" fill="var(--yellow)" stroke="var(--ink)" stroke-width="2"><animateMotion dur="2.4s" begin="1.2s" repeatCount="indefinite" path="M30 50 H80 C110 50 110 75 140 75" /></circle>
    </svg>
  )}
  {kind === "wings" && (
    <>
      {[0, 1, 2].map((i) => (
        <svg class="bird" viewBox="0 0 60 30" style={`top:${15 + i * 25}%; --d:${-i * 2.3}s; --dur:${7 + i * 2}s; --s:${0.6 + i * 0.25}`}>
          <path class="w l" d="M30 18 C20 6 8 4 2 8 C10 12 18 18 30 20" fill="#54c5f8" stroke="var(--ink)" stroke-width="2.5" />
          <path class="w r" d="M30 18 C40 6 52 4 58 8 C50 12 42 18 30 20" fill="#01579b" stroke="var(--ink)" stroke-width="2.5" />
        </svg>
      ))}
    </>
  )}
  {kind === "gradle" && (
    <div class="gradle">
      <p class="hud">Gradle sync…</p>
      <div class="bar"><i></i></div>
      <p class="eta">ETA: <span data-gradle-eta>∞</span></p>
      <svg class="droid" viewBox="0 0 60 50">
        <path d="M12 22 a18 18 0 0 1 36 0 z" fill="#3ddc84" stroke="var(--ink)" stroke-width="3" />
        <rect x="12" y="24" width="36" height="22" rx="4" fill="#3ddc84" stroke="var(--ink)" stroke-width="3" />
        <circle cx="22" cy="15" r="2.5" fill="var(--ink)" /><circle cx="38" cy="15" r="2.5" fill="var(--ink)" />
        <path d="M18 6 l-4 -5 M42 6 l4 -5" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
      </svg>
    </div>
  )}
  {kind === "pony" && (
    <>
      {Array.from({ length: 8 }, (_, i) => <i class="sparkle" style={`left:${i * 12 + 4}%; top:${(i * 31) % 80}%; --d:${(i * 0.33) % 2}s`}>✦</i>)}
      <span class="horse">🐴</span>
      <span class="magic hud">it's magic</span>
    </>
  )}
  {kind === "whale" && (
    <>
      <svg class="sea" viewBox="0 0 400 40" preserveAspectRatio="none"><path d="M0 20 C50 5 100 35 150 20 C200 5 250 35 300 20 C350 5 400 35 400 20 V40 H0 z" fill="#1d63ed" opacity="0.5" /></svg>
      <svg class="whale" viewBox="0 0 160 90">
        <g class="stack">
          <rect x="40" y="18" width="22" height="16" fill="#1d63ed" stroke="var(--ink)" stroke-width="2.5" />
          <rect x="64" y="18" width="22" height="16" fill="#1d63ed" stroke="var(--ink)" stroke-width="2.5" />
          <rect x="88" y="18" width="22" height="16" fill="#1d63ed" stroke="var(--ink)" stroke-width="2.5" />
          <rect x="52" y="2" width="22" height="16" fill="#1d63ed" stroke="var(--ink)" stroke-width="2.5" class="crate" />
          <rect x="76" y="2" width="22" height="16" fill="#1d63ed" stroke="var(--ink)" stroke-width="2.5" class="crate b" />
        </g>
        <path d="M20 40 H120 C140 40 150 50 150 60 C150 72 135 80 110 80 H40 C22 80 10 70 10 58 C10 48 14 40 20 40 z" fill="#1d63ed" stroke="var(--ink)" stroke-width="3" />
        <path d="M10 56 C0 50 0 40 6 36 C10 44 14 46 20 46" fill="#1d63ed" stroke="var(--ink)" stroke-width="3" class="tail" />
        <circle cx="132" cy="54" r="3" fill="var(--paper)" />
        <path class="spout" d="M125 40 c0 -10 6 -14 6 -20 M125 40 c-4 -8 -10 -10 -12 -16" fill="none" stroke="var(--cyan)" stroke-width="3" stroke-linecap="round" />
      </svg>
    </>
  )}
  {kind === "tensors" && (
    <>
      {Array.from({ length: 24 }, (_, i) => <span class="num" style={`left:${(i * 17) % 96}%; --d:${(i * 0.41) % 6}s; --dur:${5 + (i % 4)}s`}>{["0.12", "1", "-0.7", "[3,3]", "0", "0.98", "∇", "tf"][i % 8]}</span>)}
      <svg class="cube" viewBox="0 0 60 60">
        <path d="M30 4 L54 17 V43 L30 56 L6 43 V17 z" fill="#ff6f00" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
        <path d="M30 30 L54 17 M30 30 V56 M30 30 L6 17" fill="none" stroke="var(--ink)" stroke-width="3" />
      </svg>
    </>
  )}
  {kind === "loading" && (
    <div class="pbi">
      <div class="bars">{[0.5, 0.8, 0.35, 0.9, 0.6].map((h, i) => <i style={`--h:${h}; --d:${i * 0.3}s`}></i>)}</div>
      <p class="hud"><span class="spin">◐</span> Refreshing… 3h 59m left</p>
    </div>
  )}
  {kind === "dolphin" && (
    <>
      <svg class="sea" viewBox="0 0 400 40" preserveAspectRatio="none"><path d="M0 20 C50 5 100 35 150 20 C200 5 250 35 300 20 C350 5 400 35 400 20 V40 H0 z" fill="#00758f" opacity="0.5" /></svg>
      <svg class="dolphin" viewBox="0 0 120 60">
        <path d="M6 34 C30 10 70 10 100 26 C108 30 114 36 116 40 C104 38 96 36 86 38 C70 46 40 48 20 40 C12 42 8 46 4 50 C6 44 6 40 6 34 z" fill="#00758f" stroke="var(--ink)" stroke-width="3" stroke-linejoin="round" />
        <path d="M50 20 C56 8 66 8 70 12 C62 14 58 18 56 22 z" fill="#00758f" stroke="var(--ink)" stroke-width="3" />
        <circle cx="94" cy="30" r="2.5" fill="var(--paper)" />
      </svg>
      <span class="splash hud">SELECT * FROM 2005</span>
    </>
  )}
</div>
)}
