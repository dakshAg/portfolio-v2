---
export type ProofLink = {
  kind: "Repo" | "Live" | "PDF" | "Essay" | "Guide" | "Referral" | "Profile";
  label: string;
  href: string;
};

interface Props {
  links: ProofLink[];
}

const { links } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label="Proof of work">
  {links.map((link) => {
    const external = link.href.startsWith("http");
    return (
      <li>
        <a
          href={link.href}
          target={external ? "_blank" : undefined}
          rel={external ? "noopener noreferrer" : undefined}
          class="inline-flex items-center gap-2 rounded-full border border-border bg-background/80 px-3 py-1.5 text-sm font-medium hover:bg-secondary transition-colors"
        >
          <span class="text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-muted-foreground">{link.kind}</span>
          <span>{link.label}</span>
          <span aria-hidden="true" class="text-muted-foreground">{external ? "↗" : "→"}</span>
        </a>
      </li>
    );
  })}
</ul>
