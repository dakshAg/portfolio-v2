---
import { nav, site } from "../data/site";

const pathname = Astro.url?.pathname ?? "/";
const isActive = (href: string) => {
  const path = href.split("#")[0];
  if (!path || path === "/") return false;
  return pathname === path || pathname.startsWith(`${path}/`);
};
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:px-3 focus:py-2 focus:rounded-md focus:bg-background focus:border focus:border-border"
>
  Skip to content
</a>

<header class="sticky top-0 z-40 w-full border-b border-border/70 bg-background/80 backdrop-blur-md" transition:persist>
  <div class="container-x h-16 flex items-center justify-between gap-6">
    <a href="/" class="group inline-flex items-center gap-3 font-display text-xl tracking-tight">
      <img src="/images/icon.png" alt="" width="28" height="28" class="h-7 w-7 rounded-md" loading="eager" />
      <span>{site.name}</span>
      <span class="hidden sm:inline-block h-1.5 w-1.5 rounded-full bg-accent opacity-0 transition-opacity group-hover:opacity-100"></span>
    </a>

    <nav class="hidden md:flex items-center gap-7" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          data-scramble
          class:list={[
            "link-underline font-mono text-[12px] uppercase tracking-[0.14em] transition-colors hover:text-foreground",
            isActive(item.href) ? "text-foreground" : "text-muted-foreground",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.resume} download data-magnetic="0.25" class="btn-ghost hidden sm:inline-flex !py-2 !px-4 text-xs">
        Résumé
      </a>

      <button
        type="button"
        data-theme-toggle
        data-magnetic="0.3"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border transition-colors hover:border-foreground/60"
        aria-label="Toggle colour theme"
      >
        <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4l1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" />
        </svg>
      </button>

      <button
        type="button"
        data-menu-toggle
        class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-full border border-border"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-border bg-background">
    <nav class="container-x flex flex-col py-3" aria-label="Mobile">
      {nav.map((item) => (
        <a href={item.href} class="py-3 font-display text-2xl border-b border-border/60 last:border-0">
          {item.label}
        </a>
      ))}
      <a href={site.resume} download class="py-3 font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">
        Download résumé ↓
      </a>
    </nav>
  </div>
</header>
