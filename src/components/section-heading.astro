---
interface Props {
  index: string;
  label: string;
  title: string;
  description?: string;
  linkHref?: string;
  linkLabel?: string;
  linkExternal?: boolean;
  color?: "pink" | "cyan" | "yellow" | "lime";
}
const { index, label, title, description, linkHref, linkLabel, linkExternal, color = "yellow" } = Astro.props;
const bg = { pink: "bg-pink", cyan: "bg-cyan", yellow: "bg-yellow", lime: "bg-lime" }[color];
---

<div class="mb-12 flex flex-wrap items-end justify-between gap-6" data-reveal>
  <div class="space-y-4">
    <p class:list={["caption !rotate-[-2deg]", bg]}>
      <span class="font-pixel text-[9px] mr-2 align-middle">{index}</span>{label}
    </p>
    <h2 class="display-lg glitch" data-text={title}>{title}</h2>
    {description && <p class="max-w-xl opacity-70">{description}</p>}
  </div>
  {linkHref && (
    <a
      href={linkHref}
      target={linkExternal ? "_blank" : undefined}
      rel={linkExternal ? "noopener noreferrer" : undefined}
      class="btn-ghost !text-base"
      data-magnetic="0.3"
    >
      {linkLabel ?? "View all"} {linkExternal ? "↗" : "→"}
    </a>
  )}
</div>
