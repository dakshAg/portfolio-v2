---
import { nav, site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
  <div class="container-x py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="space-y-3">
        <a href="/" class="font-display text-2xl">{site.name}</a>
        <p class="max-w-sm text-sm text-muted-foreground">{site.tagline}</p>
        <p class="eyebrow pt-2">
          {site.location} · <span data-local-time>--:--</span>
        </p>
      </div>

      <nav class="flex flex-col gap-2 text-sm" aria-label="Footer">
        <span class="eyebrow mb-1">Pages</span>
        {nav.map((item) => (
          <a href={item.href} class="link-underline w-fit text-muted-foreground hover:text-foreground">{item.label}</a>
        ))}
      </nav>

      <div class="flex flex-col gap-2 text-sm">
        <span class="eyebrow mb-1">Elsewhere</span>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="link-underline w-fit text-muted-foreground hover:text-foreground">GitHub ↗</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link-underline w-fit text-muted-foreground hover:text-foreground">LinkedIn ↗</a>
        <a href={site.substack} target="_blank" rel="noopener noreferrer" class="link-underline w-fit text-muted-foreground hover:text-foreground">Substack ↗</a>
        <a href={`mailto:${site.email}`} class="link-underline w-fit text-muted-foreground hover:text-foreground">{site.email}</a>
      </div>
    </div>

    <div class="mt-12 flex items-center justify-between gap-4 border-t border-border pt-6 text-xs text-muted-foreground">
      <span>© {year} {site.name}</span>
      <a href="#" class="link-underline font-mono uppercase tracking-[0.14em]">Back to top ↑</a>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const el = document.querySelector("[data-local-time]");
    if (!el) return;
    const fmt = new Intl.DateTimeFormat("en-AU", {
      timeZone: "Australia/Melbourne",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    });
    const tick = () => { el.textContent = fmt.format(new Date()) + " AEST"; };
    tick();
    setInterval(tick, 30000);
  })();
</script>
