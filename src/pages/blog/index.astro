---
import Layout from "../../layouts/main.astro";
import { getCollection } from "astro:content";
import { site } from "../../data/site";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmt = (d: Date) => d.toLocaleDateString("en-AU", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="Writing — Daksh Agrawal" description="Thoughts on technology, entrepreneurship, and the intersection of data and business.">
  <section class="container-x pt-16 pb-12 sm:pt-24">
    <p class="eyebrow fade-up mb-6" style="--d: 60ms">Writing · {posts.length} posts</p>
    <h1 class="font-display text-6xl leading-[0.95] sm:text-8xl">
      <span class="mask-line"><span style="--d: 120ms">Notes on data,</span></span>
      <span class="mask-line"><span style="--d: 240ms" class="text-muted-foreground">products & people.</span></span>
    </h1>
    <p class="fade-up mt-8 text-muted-foreground" style="--d: 400ms">
      Longer essays live on
      <a href={site.substack} target="_blank" rel="noopener noreferrer" class="link-underline text-foreground">Substack ↗</a>.
    </p>
  </section>

  <section class="container-x pb-24">
    <ol class="divide-y divide-border border-y border-border" data-reveal-stagger>
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}`} class="group grid gap-4 py-8 sm:grid-cols-[8rem_1fr_12rem] sm:gap-8">
            <time class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground" datetime={p.data.pubDate.toISOString()}>
              {fmt(p.data.pubDate)}
            </time>
            <div>
              <h2 class="font-display text-3xl leading-tight transition-colors group-hover:text-accent sm:text-4xl">{p.data.title}</h2>
              <p class="mt-2 max-w-xl text-muted-foreground">{p.data.description}</p>
              {p.data.tags && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {p.data.tags.map((t: string) => <span class="chip !py-0.5 text-[11px]">{t}</span>)}
                </div>
              )}
            </div>
            {p.data.heroImage && (
              <div class="card aspect-[4/3] overflow-hidden sm:aspect-auto sm:h-28">
                <img src={p.data.heroImage} alt="" class="img-zoom h-full w-full object-cover" loading="lazy" />
              </div>
            )}
          </a>
        </li>
      ))}
    </ol>
  </section>
</Layout>
