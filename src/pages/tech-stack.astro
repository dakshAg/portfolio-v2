---
import Layout from "../layouts/main.astro";
import { tiers } from "../data/site";
---

<Layout title="Tech Stack — Daksh Agrawal" description="My personal tier list of technologies and tools.">
  <section class="container-x pt-16 pb-12 sm:pt-24">
    <p class="eyebrow fade-up mb-6" style="--d: 60ms">Tech stack · tier list</p>
    <h1 class="font-display text-6xl leading-[0.95] sm:text-8xl">
      <span class="mask-line"><span style="--d: 120ms">Tools I reach for,</span></span>
      <span class="mask-line"><span style="--d: 240ms" class="text-muted-foreground">ranked honestly.</span></span>
    </h1>
    <p class="fade-up mt-8 max-w-2xl text-lg text-muted-foreground" style="--d: 400ms">
      S-tier are absolute favourites, A-tier are battle-tested, B-tier are situational, and C-tier are
      ones I avoid when possible. All of these have shipped real projects, from startups to side builds.
    </p>
  </section>

  <div class="container-x space-y-6 pb-24">
    {tiers.map((tier) => (
      <section class="grid gap-6 border-t border-border py-10 md:grid-cols-[12rem_1fr]" data-reveal>
        <div class="flex items-center gap-4 md:flex-col md:items-start">
          <img src={tier.badge} alt={`${tier.key} tier`} width="64" height="64" class="h-16 w-16" loading="lazy" />
          <div>
            <h2 class="font-display text-4xl leading-none">{tier.key}-Tier</h2>
            <p class="mt-2 text-sm text-muted-foreground">{tier.blurb}</p>
          </div>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
          {tier.tools.map((tool) => (
            <li class="card group p-4 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
              <div class="flex items-center gap-3">
                <span class="flex h-11 w-11 flex-none items-center justify-center rounded-lg bg-secondary">
                  <img src={tool.icon} alt="" width="28" height="28" class="h-7 w-7 object-contain" loading="lazy" />
                </span>
                <h3 class="font-medium">{tool.name}</h3>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{tool.note}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
