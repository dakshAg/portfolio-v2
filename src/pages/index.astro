---
import Layout from "../layouts/main.astro";
import SectionHeading from "../components/section-heading.astro";
import MisregImage from "../components/misreg-image.astro";
import Multiverse from "../components/multiverse.astro";
import Vibe from "../components/vibe.astro";
import InkIcon from "../components/ink-icon.astro";
import Burst from "../components/burst.astro";
import { getCollection } from "astro:content";
import { site, experience, education, projects, values, referees, player2 } from "../data/site";

const gallery = (await getCollection("gallery"))
  .filter((i) => !i.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);

const featured = projects.filter((p) => p.featured);
const archive = projects.filter((p) => !p.featured);

const fmtDate = (d: Date) => d.toLocaleDateString("en-AU", { year: "numeric", month: "short", day: "numeric" });

/* RPG stat sheet: value per skill (0–1) */
const stats = [
  { label: "Software Engineering", v: 0.92, bar: "var(--pink)" },
  { label: "Data Science", v: 0.95, bar: "var(--cyan)" },
  { label: "Finance", v: 0.74, bar: "var(--yellow)" },
  { label: "Teaching", v: 0.86, bar: "var(--lime)" },
  { label: "Product Thinking", v: 0.88, bar: "var(--violet)" },
];

const tape = [
  "Head of Data @ Cruz Trading", "ex Square Peg", "ex CTO @ G7", "H1 Data Science @ Unimelb", "Melbourne, AU",
  "Builds things that ship", "Dean's Honours", "10,000+ truckers served", "Quant pipelines", "Founder energy",
];
const rot = ["-2deg", "1.5deg", "-1deg", "2deg", "-1.5deg", "1deg"];
const vibeFor = (company: string): "water" | "ticker" | "peg" | "trucks" | "chalk" | "stars" | null => {
  if (/taswater/i.test(company)) return "water";
  if (/cruz/i.test(company)) return "ticker";
  if (/square peg/i.test(company)) return "peg";
  if (/g7/i.test(company)) return "trucks";
  if (/melbourne/i.test(company)) return "chalk";
  return null;
};
const stickerColors = ["sticker-pink", "sticker-cyan", "sticker-yellow", "sticker-lime", "sticker-paper"];
const arrow = `<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="square" d="M7 17L17 7M8 7h9v9"/></svg>`;
---

<Layout title="Daksh Agrawal — Data scientist, founder, engineer">
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden border-b-[3px] border-paper">
    <canvas class="absolute inset-0 h-full w-full" data-field aria-hidden="true"></canvas>
    <div class="pointer-events-none absolute -right-24 top-10 h-[34rem] w-[34rem] rounded-full bg-violet/40 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-32 bottom-0 h-[26rem] w-[26rem] rounded-full bg-pink/25 blur-3xl" aria-hidden="true"></div>

    <div class="container-x relative pt-12 pb-16 sm:pt-20 sm:pb-24">
      <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="relative">
          <p class="fade-up mb-6 flex flex-wrap items-center gap-3" style="--d: 40ms">
            <span class="sticker sticker-lime !text-sm" style="--rot: -2deg">● Online</span>
            <span class="hud text-cyan">{site.location}</span>
            <span class="hud text-muted">Earth-616 · Player 1</span>
          </p>

          <h1 class="display-xl leading-[0.85]" aria-label={`${site.name}, a ${site.roles[0]}`}>
            <span class="slam block chroma-lg glitch" data-text="DAKSH" data-glitch-auto style="--d: 80ms">DAKSH</span>
            <span class="slam block outline-text glitch" data-text="AGRAWAL" data-glitch-auto style="--d: 200ms">AGRAWAL</span>
          </h1>

          <div class="fade-up mt-6 flex flex-wrap items-center gap-3" style="--d: 340ms">
            <span class="hud text-pink">CLASS:</span>
            <span class="caption !rotate-0 bg-cyan !text-2xl"><span data-rotator data-words={site.roles.join("|")}>{site.roles[0]}</span></span>
          </div>

          <p class="fade-up mt-8 max-w-xl text-lg text-paper/85 sm:text-xl" style="--d: 440ms">
            {site.tagline} I build data systems and products that ship — quant trading pipelines,
            a logistics platform serving ten thousand truckers, and a pile of weird side quests.
          </p>

          <div class="fade-up mt-8 flex flex-wrap items-center gap-4" style="--d: 560ms">
            <a href="#contact" class="btn-pink" data-magnetic="0.3">Let's talk <Fragment set:html={arrow} /></a>
            <a href="#projects" class="btn-ghost" data-magnetic="0.3">Level select ▼</a>
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="sticker sticker-paper !text-sm" data-magnetic="0.4" style="--rot: 3deg">GitHub ↗</a>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="sticker sticker-cyan !text-sm" data-magnetic="0.4" style="--rot: -3deg">LinkedIn ↗</a>
          </div>
        </div>

        <!-- Avatar panel -->
        <div class="fade-up relative mx-auto w-full max-w-sm lg:mx-0 lg:justify-self-end" style="--d: 260ms">
          <Burst text="POW!" class="absolute -top-8 left-0 z-10 rotate-[-12deg] sm:-left-8" size={110} color="var(--pink)" />
          <Burst text="SHIP IT" class="absolute -bottom-6 right-0 z-10 rotate-[10deg] sm:-right-6" size={120} color="var(--cyan)" />
          <div class="panel rotate-[2deg] p-3" data-tilt="8">
            <div class="halftone absolute inset-0 opacity-30" style="--ht-color: var(--pink); --ht-size: 2px; --ht-gap: 9px" aria-hidden="true"></div>
            <div class="group relative aspect-square overflow-hidden border-[3px] border-ink bg-yellow" data-avatar data-cursor-label="Poke">
              <div class="halftone absolute inset-0" style="--ht-color: var(--ink); --ht-size: 1.5px; --ht-gap: 8px; opacity: 0.25" aria-hidden="true"></div>
              <Multiverse src="/images/hero-avatar.png" alt="Illustration of Daksh Agrawal" class="h-full w-full" loading="eager" />
            </div>
            <div class="mt-3 flex items-center justify-between">
              <span class="hud text-ink">HP ████████░░</span>
              <span class="hud text-ink">LVL ??</span>
            </div>
          </div>
          <span class="sticker sticker-yellow absolute -left-6 bottom-10 !text-sm" style="--rot: -8deg" data-float>Head of Data</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TAPE MARQUEE ============ -->
  <section aria-label="Highlights" class="relative -rotate-1 scale-[1.02] border-y-[3px] border-ink bg-yellow py-3 text-ink">
    <div class="marquee" style="--speed: 30s">
      {[0, 1].map((copy) => (
        <ul class="marquee__track" aria-hidden={copy === 1 ? "true" : undefined}>
          {tape.map((t) => (
            <li class="flex items-center gap-6 font-display text-2xl uppercase tracking-wider">
              {t} <span class="text-pink">★</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>
  <section aria-hidden="true" class="relative rotate-1 border-y-[3px] border-paper bg-pink py-2 text-ink">
    <div class="marquee" data-reverse style="--speed: 22s">
      {[0, 1].map(() => (
        <ul class="marquee__track">
          {experience.map((e) => (
            <li class="flex items-center gap-3 hud">
              <img src={e.logo} alt="" width="22" height="22" class="h-[22px] w-[22px] border-2 border-ink object-cover" loading="lazy" />
              {e.company}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- ============ EXPERIENCE: campaign log ============ -->
  <section id="work" class="container-x relative scroll-mt-24 py-24 sm:py-32">
    <div class="halftone halftone-fade pointer-events-none absolute inset-x-0 top-0 h-64 opacity-40" style="--ht-color: var(--cyan); --ht-size: 1.5px; --ht-gap: 10px" aria-hidden="true"></div>
    <SectionHeading index="01" label="Campaign log" title="Where I've built things" color="cyan" description="Chapters so far. Each one shipped something real." />

    <ol class="grid gap-8 md:grid-cols-2">
      {experience.map((job, i) => (
        <li
          class:list={["panel wobble p-6 sm:p-7", i === 0 && "md:col-span-2"]}
          data-reveal
          data-vibe={vibeFor(job.company)}
          style={`--r: ${rot[i % rot.length]}; --r0: ${i % 2 ? "3deg" : "-3deg"}`}
        >
          <div class="halftone pointer-events-none absolute inset-0 opacity-[0.12]" style="--ht-size: 1px; --ht-gap: 6px" aria-hidden="true"></div>
          {vibeFor(job.company) && <Vibe kind={vibeFor(job.company)!} />}
          <div class="relative flex flex-wrap items-start justify-between gap-4">
            <span class="caption bg-pink">CH.{String(i + 1).padStart(2, "0")}</span>
            <span class="sticker sticker-cyan !text-xs" style={`--rot: ${i % 2 ? "3deg" : "-3deg"}`}>{job.period}</span>
          </div>
          <div class="relative mt-6 flex gap-5">
            <img src={job.logo} alt="" width="56" height="56" class="h-14 w-14 flex-none border-[3px] border-ink object-cover shadow-hard-sm" loading="lazy" />
            <div>
              <h3 class="font-display text-4xl leading-none sm:text-5xl">
                {job.href ? (
                  <a href={job.href} target="_blank" rel="noopener noreferrer" class="underline decoration-pink decoration-4 underline-offset-4 hover:bg-yellow">{job.company}</a>
                ) : job.company}
              </h3>
              <p class="hud mt-3 text-ink/70">{job.role}</p>
              <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink/85">{job.summary}</p>
            </div>
          </div>
        </li>
      ))}

      <li class="panel-dark wobble overflow-hidden p-6 sm:p-7" data-reveal style="--r: 1deg; --r0: 4deg">
        <Vibe kind="stars" />
        <div class="relative flex flex-wrap items-start justify-between gap-4">
          <span class="caption bg-lime">ORIGIN</span>
          <span class="sticker sticker-yellow !text-xs" style="--rot: 4deg">H1 · Dean's Honours</span>
        </div>
        <div class="relative mt-6 flex gap-5">
          <img src={education.logo} alt="" width="56" height="56" class="h-14 w-14 flex-none border-[3px] border-paper bg-paper object-contain p-1" loading="lazy" />
          <div>
            <h3 class="font-display text-4xl leading-none sm:text-5xl">{education.school}</h3>
            <p class="hud mt-3 text-cyan">{education.degree}</p>
            <p class="mt-4 text-[15px] text-paper/80">{education.detail}</p>
          </div>
        </div>
      </li>
    </ol>
  </section>

  <!-- ============ PROJECTS: level select ============ -->
  <section id="projects" class="relative scroll-mt-24 border-y-[3px] border-paper bg-ink py-24 sm:py-32">
    <div class="stripes absolute inset-x-0 top-0 h-3" style="--stripe-a: var(--cyan); --stripe-b: var(--ink)" aria-hidden="true"></div>
    <div class="container-x">
      <SectionHeading index="02" label="Level select" title="Selected work" color="pink" description="Hover a level to preview. A few things I've shipped, plus unlockable side quests from the archive." />

      <!-- Desktop: rows with floating preview -->
      <div class="hidden lg:block" data-preview-list>
        <ol class="border-y-[3px] border-paper" data-reveal>
          {featured.map((p, i) => {
            const primary = p.links[0];
            const Tag = primary ? "a" : "div";
            return (
              <li data-preview={p.image} class="border-b-[3px] border-paper/40 last:border-0">
                <Tag
                  href={primary?.href}
                  target={primary ? "_blank" : undefined}
                  rel={primary ? "noopener noreferrer" : undefined}
                  data-cursor-label={primary ? "Press A" : "Locked"}
                  class="group grid grid-cols-[4rem_1fr_auto_5rem_3rem] items-center gap-6 py-7 transition-colors hover:bg-paper hover:text-ink"
                >
                  <span class="font-pixel text-xs text-pink">L{i + 1}</span>
                  <div class="flex items-center gap-5">
                    <img src={p.icon} alt="" width="48" height="48" class="h-12 w-12 border-[3px] border-current object-cover" loading="lazy" />
                    <div>
                      <h3 class="font-display text-5xl leading-none transition-transform group-hover:translate-x-2 group-hover:skew-x-[-6deg]">{p.title}</h3>
                      <p class="mt-2 max-w-lg text-sm opacity-75">{p.description}</p>
                    </div>
                  </div>
                  <div class="flex gap-2">{p.tags.map((t) => <span class="chip-dark group-hover:border-ink group-hover:text-ink">{t}</span>)}</div>
                  <span class="text-right font-pixel text-[10px] opacity-70">{p.year}</span>
                  <span class="font-display text-3xl text-yellow transition-transform group-hover:translate-x-1">{primary ? "▶" : "🔒"}</span>
                </Tag>
              </li>
            );
          })}
        </ol>
        <div class="preview-float" data-preview-float aria-hidden="true">
          <img src={featured[0].image} alt="" class="h-full w-full object-cover" />
        </div>
      </div>

      <!-- Tablet / mobile: cabinet cards -->
      <div class="grid gap-8 sm:grid-cols-2 lg:hidden" data-reveal-stagger>
        {featured.map((p, i) => {
          const primary = p.links[0];
          const Tag = primary ? "a" : "div";
          return (
            <article class="group panel tilted p-3" style={`--r: ${rot[i % rot.length]}`} data-tilt="5">
              <Tag href={primary?.href} target={primary ? "_blank" : undefined} rel={primary ? "noopener noreferrer" : undefined} class="block">
                <div class="relative aspect-[16/10] border-[3px] border-ink">
                  <MisregImage src={p.image} alt={p.title} class="h-full w-full" />
                  <span class="caption absolute left-2 top-2 bg-pink !text-sm">L{i + 1}</span>
                  <span class="absolute right-2 top-2 chip">{p.year}</span>
                </div>
              </Tag>
              <div class="space-y-3 p-3">
                <div class="flex items-center gap-3">
                  <img src={p.icon} alt="" width="36" height="36" class="h-9 w-9 border-2 border-ink object-cover" loading="lazy" />
                  <h3 class="font-display text-3xl leading-none">{p.title}</h3>
                </div>
                <p class="text-sm text-ink/80">{p.description}</p>
                <div class="flex flex-wrap items-center gap-2 pt-1">
                  {p.tags.map((t) => <span class="chip">{t}</span>)}
                  <span class="ml-auto flex gap-3">
                    {p.links.map((l) => (
                      <a href={l.href} target="_blank" rel="noopener noreferrer" class="hud text-pink underline">{l.label}</a>
                    ))}
                    {p.links.length === 0 && <span class="hud text-ink/50">🔒 Private</span>}
                  </span>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <details class="group mt-12" data-reveal>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 border-y-[3px] border-paper py-4 [&::-webkit-details-marker]:hidden" data-cursor-label="Unlock">
          <span class="font-display text-2xl tracking-wider">
            <span class="text-yellow">SIDE QUESTS</span> · {archive.length} earlier builds (2016–2019)
          </span>
          <span class="font-display text-3xl text-pink transition-transform duration-300 group-open:rotate-45">+</span>
        </summary>
        <ol class="grid gap-4 py-6 sm:grid-cols-2 lg:grid-cols-3">
          {archive.map((p, i) => (
            <li class="panel-void tilted flex gap-4 p-4" style={`--r: ${rot[(i + 2) % rot.length]}`}>
              <img src={p.icon} alt="" width="40" height="40" class="h-10 w-10 flex-none border-2 border-paper object-cover" loading="lazy" />
              <div>
                <h3 class="font-display text-2xl leading-none">{p.title} <span class="hud text-muted">{p.year}</span></h3>
                <p class="mt-2 text-sm text-paper/75">{p.description}</p>
                <div class="mt-3 flex flex-wrap gap-1.5">{p.tags.map((t) => <span class="chip-dark !text-[9px]">{t}</span>)}</div>
              </div>
            </li>
          ))}
        </ol>
      </details>
    </div>
  </section>

  <!-- ============ STATS + PERKS ============ -->
  <section class="container-x py-24 sm:py-32">
    <div class="grid gap-16 lg:grid-cols-2">
      <div>
        <SectionHeading index="03" label="Stat sheet" title="What I bring" color="lime" />
        <ul class="panel space-y-5 p-6 sm:p-8" data-reveal style="--r: -1deg">
          {stats.map((s, i) => (
            <li>
              <div class="mb-2 flex items-center justify-between gap-3">
                <span class="flex items-center gap-3 font-display text-2xl tracking-wide">
                  <InkIcon name={s.label} class="h-8 w-8" />
                  {s.label}
                </span>
                <span class="font-pixel text-[10px]">{Math.round(s.v * 100)}</span>
              </div>
              <div class="statbar" style={`--v: ${s.v}; --bar: ${s.bar}; --bar-delay: ${i * 120}ms`}><i></i></div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <SectionHeading index="04" label="Perks" title="How I work" color="yellow" />
        <ul class="flex flex-wrap gap-5" data-reveal>
          {values.map((v, i) => (
            <li class:list={["sticker !gap-3 !px-5 !py-3 !text-2xl", stickerColors[i % stickerColors.length]]} style={`--rot: ${rot[i % rot.length]}`} data-magnetic="0.25">
              <InkIcon name={v.label} />
              {v.label}
            </li>
          ))}
        </ul>
        <div class="mt-10 dialogue" data-reveal style="--r: 1deg">
          <p class="hud mb-3 text-yellow">▸ NARRATOR</p>
          <p class="font-mono text-sm leading-relaxed">
            "He picked <b class="text-pink">EXCELLENCE</b> and <b class="text-cyan">COURAGE</b> as starting perks. Reckless.
            Then he added <b class="text-lime">DISCIPLINE</b> and it started to work."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NPC DIALOGUE ============ -->
  <section class="relative border-y-[3px] border-paper bg-violet/20 py-24 sm:py-32">
    <div class="halftone pointer-events-none absolute inset-0 opacity-30" style="--ht-color: var(--violet); --ht-size: 2px; --ht-gap: 12px" aria-hidden="true"></div>
    <div class="container-x relative">
      <SectionHeading index="05" label="NPC dialogue" title="In their words" color="pink" description="People I've worked with. Press to read the full line." />

      <div class="grid gap-10 md:grid-cols-2" data-reveal-stagger>
        {referees.map((r, i) => {
          const id = `ref-${i}`;
          return (
            <>
              <div class="relative">
                <button type="button" data-open-dialog={id} data-tilt="5" data-cursor-label="Talk" class="group bubble tilted w-full text-left" style={`--r: ${i ? "1deg" : "-1deg"}`}>
                  <span class="caption absolute -top-5 left-6 bg-cyan !text-sm">{r.name}</span>
                  <p class="line-clamp-4 pt-3 font-sans text-base leading-relaxed sm:text-lg">"{r.quote}"</p>
                  <p class="hud mt-5 text-pink group-hover:text-ink">▸ Read full line</p>
                </button>
                <div class="mt-8 flex items-center gap-4 pl-2">
                  <Multiverse src={r.image} alt="" class="group h-14 w-14 flex-none border-[3px] border-paper shadow-[4px_4px_0_var(--pink)]" ambient={false} />
                  <div>
                    <p class="font-display text-2xl tracking-wide">{r.name}</p>
                    <p class="hud mt-1 text-muted">{r.position}</p>
                  </div>
                </div>
              </div>

              <dialog id={id} data-dialog class="w-[min(94vw,46rem)]">
                <div class="dialogue">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex items-center gap-4">
                      <img src={r.image} alt="" width="48" height="48" class="h-12 w-12 border-2 border-paper object-cover" />
                      <div>
                        <p class="font-display text-2xl tracking-wide text-yellow">{r.name}</p>
                        <p class="hud mt-1 text-muted">{r.position}</p>
                      </div>
                    </div>
                    <button type="button" data-close-dialog class="btn-yellow !px-3 !py-1.5 !text-base">✕ Close</button>
                  </div>
                  <p class="mt-6 font-mono text-sm leading-relaxed sm:text-base" data-typewriter={r.quote}>{r.quote}</p>
                </div>
              </dialog>
            </>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ ISSUES (writing) ============ -->
  <section class="container-x py-24 sm:py-32">
    <SectionHeading index="06" label="Back issues" title="Notes & essays" color="cyan" linkHref={site.substack} linkLabel="Substack" linkExternal />

    <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
      {posts.map((p, i) => (
        <li>
          <a href={`/blog/${p.slug}`} data-cursor-label="Read" class="group panel tilted block p-3" style={`--r: ${rot[i % rot.length]}`}>
            <div class="relative aspect-[3/4] border-[3px] border-ink bg-cyan">
              {p.data.heroImage && <Multiverse src={p.data.heroImage} alt="" class="h-full w-full" />}
              <span class="absolute left-2 top-2 chip !bg-yellow">#{String(posts.length - i).padStart(3, "0")}</span>
              <span class="absolute bottom-2 right-2 chip">{fmtDate(p.data.pubDate)}</span>
            </div>
            <h3 class="mt-4 font-display text-3xl leading-none">{p.data.title}</h3>
            <p class="mt-2 line-clamp-2 text-sm text-ink/75">{p.data.description}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ LOOT (gallery) ============ -->
  <section class="relative border-y-[3px] border-paper bg-cyan py-24 text-ink sm:py-32">
    <div class="halftone pointer-events-none absolute inset-0 opacity-20" style="--ht-size: 2px; --ht-gap: 10px" aria-hidden="true"></div>
    <div class="container-x relative">
      <SectionHeading index="07" label="Loot" title="Moments & music" color="pink" description="Drag to browse." linkHref="/gallery" linkLabel="Gallery" />
    </div>

    <div
      class="no-scrollbar relative flex snap-x gap-8 overflow-x-auto pb-6 pt-4"
      style="padding-left: max(1rem, calc((100vw - 72rem) / 2 + 2rem)); padding-right: max(1rem, calc((100vw - 72rem) / 2 + 2rem));"
      data-drag-scroll
      data-cursor-label="Drag"
      data-reveal
    >
      {gallery.map((g, i) => (
        <a href="/gallery" class="group panel tilted w-[76vw] flex-none snap-start p-3 pb-5 sm:w-[22rem]" draggable="false" style={`--r: ${rot[i % rot.length]}`}>
          <span class="stripes absolute -top-3 left-1/2 h-6 w-24 -translate-x-1/2 rotate-[-4deg] opacity-90" style="--stripe-a: var(--yellow); --stripe-b: var(--pink)" aria-hidden="true"></span>
          <div class="aspect-[4/3] border-[3px] border-ink">
            <Multiverse src={g.data.image} alt={g.data.alt ?? g.data.caption} class="h-full w-full" />
          </div>
          <p class="mt-3 font-display text-2xl">{g.data.caption}</p>
          <p class="hud mt-1 text-ink/60">{fmtDate(g.data.date)}</p>
        </a>
      ))}
      <div class="panel-dark tilted flex w-[76vw] flex-none snap-start flex-col overflow-hidden sm:w-[22rem]" style="--r: 1deg">
        <p class="caption absolute -top-4 left-4 bg-lime !text-sm">On repeat</p>
        <iframe
          title="Spotify playlist"
          src="https://open.spotify.com/embed/playlist/6j5rNmQdrBG4WdLW86topD?utm_source=generator&theme=0"
          width="100%"
          height="352"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          class="mt-4 border-0"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ============ PLAYER 2 (hidden until you type "love") ============ -->
  <section id="player2" data-p2 class="relative scroll-mt-24 border-y-[3px] border-paper bg-pink py-24 text-ink sm:py-32">
    <div class="halftone pointer-events-none absolute inset-0 opacity-25" style="--ht-size: 2px; --ht-gap: 10px" aria-hidden="true"></div>
    <div class="container-x relative">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <div class="space-y-4">
          <p class="caption bg-paper !rotate-[-2deg]"><span class="font-pixel text-[9px] mr-2 align-middle">P2</span>Co-op campaign</p>
          <h2 class="display-lg glitch" data-text="Player 2 has joined" data-glitch-auto>Player 2 <span class="pulse-heart">♥</span> has joined</h2>
          <p class="max-w-xl opacity-80">{player2.tagline}</p>
        </div>
        <div class="dialogue !border-ink !bg-ink !text-paper" style="box-shadow: 0 0 0 3px var(--ink), 0 0 0 6px var(--paper), 8px 8px 0 6px var(--yellow)">
          <p class="hud text-yellow">▸ SINCE</p>
          <p class="combo mt-1 text-4xl">{player2.since}</p>
          <p class="hud mt-2 text-lime">COMBO ×∞</p>
        </div>
      </div>

      <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr]">
        <ul class="panel space-y-5 p-6 sm:p-8" data-reveal style="--r: -1deg">
          <li class="hud text-pink">▸ PARTY STATS</li>
          {player2.stats.map((s, i) => (
            <li>
              <div class="mb-2 flex items-center justify-between gap-3">
                <span class="font-display text-2xl tracking-wide">{s.label}</span>
                <span class="font-pixel text-[10px]">{Math.round(s.v * 100)}</span>
              </div>
              <div class="statbar" style={`--v: ${s.v}; --bar: ${s.bar}; --bar-delay: ${i * 120}ms`}><i></i></div>
            </li>
          ))}
          <li class="bubble mt-4 !p-4 text-sm leading-relaxed">
            <p class="hud mb-2 text-pink">▸ P1</p>
            {player2.letter}
          </li>
        </ul>

        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3" data-reveal-stagger>
          {player2.photos.map((ph, i) => (
            <figure class="group panel tilted p-3 pb-4" style={`--r: ${rot[(i + 1) % rot.length]}`}>
              <span class="stripes absolute -top-3 left-1/2 h-5 w-20 -translate-x-1/2 rotate-[-6deg]" style="--stripe-a: var(--yellow); --stripe-b: var(--pink)" aria-hidden="true"></span>
              <div class="aspect-[4/5] border-[3px] border-ink">
                <Multiverse src={ph.src} alt={ph.caption} class="h-full w-full" />
              </div>
              <figcaption class="mt-3">
                <p class="font-display text-xl">{ph.caption}</p>
                <p class="hud mt-1 opacity-60">{ph.date}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTINUE? (contact) ============ -->
  <section id="contact" class="container-x relative scroll-mt-24 py-28 sm:py-40">
    <div class="halftone halftone-fade pointer-events-none absolute inset-x-0 bottom-0 h-72 opacity-40" style="--ht-color: var(--pink); --ht-size: 2px; --ht-gap: 9px; --ht-dir: 0deg" aria-hidden="true"></div>
    <div class="relative grid items-center gap-10 lg:grid-cols-[auto_1fr]" data-reveal>
      <div class="grid place-items-center">
        <p class="hud text-pink">CONTINUE?</p>
        <p class="countdown-digit display-xl chroma-lg leading-none" data-countdown aria-hidden="true">9</p>
      </div>
      <div class="max-w-3xl">
        <p class="caption bg-yellow mb-6"><span class="font-pixel text-[9px] mr-2 align-middle">08</span>Contact</p>
        <h2 class="display-lg glitch" data-text="Wondering how we can build the next big thing together?">
          Wondering how we can build <span class="text-pink">the next big thing</span> together?
        </h2>
        <p class="mt-6 max-w-xl text-lg text-paper/80">
          I'm open to interesting problems in data, product, and infrastructure. Email is fastest. Insert coin to continue.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={`mailto:${site.email}`} class="btn-pink" data-magnetic="0.3">
            Insert coin <Fragment set:html={arrow} />
          </a>
          <button type="button" data-copy={site.email} data-magnetic="0.3" class="btn-cyan">
            <span data-copy-label>Copy email</span>
          </button>
          <a href={site.phoneHref} class="btn-ghost !text-base" data-magnetic="0.3">{site.phone}</a>
        </div>
        <p class="mt-8 font-mono text-xs uppercase tracking-widest text-muted">Tip: <span class="text-pink">↑ ↑ ↓ ↓ ← → ← → B A</span> · press <span class="text-yellow">?</span> · <button type="button" data-love-trigger class="pulse-heart text-pink" aria-label="Secret">♥</button></p>
      </div>
    </div>
  </section>
</Layout>
