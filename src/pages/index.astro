---
import Layout from "../layouts/main.astro";
import SectionHeading from "../components/section-heading.astro";
import { getCollection } from "astro:content";
import { site, experience, education, projects, skills, values, referees } from "../data/site";

const gallery = (await getCollection("gallery"))
  .filter((i) => !i.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);

const featured = projects.filter((p) => p.featured);
const archive = projects.filter((p) => !p.featured);

const marqueeLogos = experience.map((e) => ({ name: e.company, logo: e.logo }));

const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-AU", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title="Daksh Agrawal — Data scientist, founder, engineer">
  <!-- ============ HERO ============ -->
  <section class="container-x pt-16 pb-14 sm:pt-24 sm:pb-20">
    <div class="grid items-end gap-10 lg:grid-cols-[1fr_auto]">
      <div>
        <p class="eyebrow fade-up mb-6 flex items-center gap-3" style="--d: 80ms">
          <span class="pulse-dot inline-block h-2 w-2 rounded-full bg-accent"></span>
          Head of Data @ Cruz Trading · {site.location}
        </p>

        <h1 class="font-display text-[15vw] leading-[0.92] sm:text-7xl md:text-8xl lg:text-[6.5rem]">
          <span class="mask-line"><span style="--d: 120ms">Daksh Agrawal,</span></span>
          <span class="mask-line">
            <span style="--d: 240ms" class="text-muted-foreground">
              a <em class="rotator not-italic text-foreground" data-rotator aria-live="polite">
                {site.roles.map((r, i) => (
                  <span class:list={["italic", i === 0 && "is-current"]}>{r}.</span>
                ))}
              </em>
            </span>
          </span>
        </h1>

        <p class="fade-up mt-8 max-w-xl text-lg text-muted-foreground sm:text-xl" style="--d: 420ms">
          {site.tagline} I build data systems and products that ship, from quant trading
          pipelines to a logistics platform serving ten thousand truckers.
        </p>

        <div class="fade-up mt-8 flex flex-wrap items-center gap-3" style="--d: 540ms">
          <a href="#contact" class="btn-primary">
            Let's talk
            <svg class="arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
          <a href={site.resume} download class="btn-ghost">Download résumé</a>
          <div class="ml-1 flex items-center gap-1">
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="chip !py-2" aria-label="GitHub">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="chip !py-2" aria-label="LinkedIn">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="fade-up relative mx-auto lg:mx-0" style="--d: 300ms">
        <div class="floaty">
          <img
            src="/images/hero-avatar.png"
            alt="Illustration of Daksh Agrawal"
            width="260"
            height="260"
            class="h-44 w-44 object-contain sm:h-56 sm:w-56 lg:h-64 lg:w-64"
            loading="eager"
            decoding="async"
          />
        </div>
        <span class="absolute -bottom-3 left-1/2 h-3 w-40 -translate-x-1/2 rounded-full bg-foreground/10 blur-md" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <section class="border-y border-border py-6" aria-label="Places I've worked">
    <div class="marquee">
      {[0, 1].map((copy) => (
        <ul class="marquee__track" aria-hidden={copy === 1 ? "true" : undefined}>
          {marqueeLogos.map((l) => (
            <li class="flex items-center gap-3 whitespace-nowrap font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">
              <img src={l.logo} alt="" width="28" height="28" class="h-7 w-7 rounded-md object-cover grayscale" loading="lazy" />
              {l.name}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <!-- ============ EXPERIENCE ============ -->
  <section id="work" class="container-x scroll-mt-24 py-20 sm:py-28">
    <SectionHeading index="01" label="Experience" title="Where I've built things" />

    <div class="relative pl-8 sm:pl-12">
      <div class="timeline-rail" data-timeline aria-hidden="true"></div>

      <ol class="space-y-12">
        {experience.map((job) => (
          <li class="relative" data-reveal>
            <span class="absolute -left-8 top-2 h-2 w-2 -translate-x-1/2 rounded-full border border-background bg-accent sm:-left-12" aria-hidden="true"></span>
            <div class="grid gap-4 sm:grid-cols-[9rem_1fr] sm:gap-8">
              <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground sm:pt-1">{job.period}</p>
              <div class="flex gap-5">
                <img src={job.logo} alt="" width="48" height="48" class="hidden h-12 w-12 flex-none rounded-lg object-cover sm:block" loading="lazy" />
                <div class="space-y-2">
                  <h3 class="font-display text-2xl leading-tight sm:text-3xl">
                    {job.href ? (
                      <a href={job.href} target="_blank" rel="noopener noreferrer" class="link-underline">{job.company}</a>
                    ) : job.company}
                    <span class="text-muted-foreground"> — {job.role}</span>
                  </h3>
                  <p class="max-w-2xl text-muted-foreground">{job.summary}</p>
                </div>
              </div>
            </div>
          </li>
        ))}

        <li class="relative" data-reveal>
          <span class="absolute -left-8 top-2 h-2 w-2 -translate-x-1/2 rounded-full border border-background bg-foreground sm:-left-12" aria-hidden="true"></span>
          <div class="grid gap-4 sm:grid-cols-[9rem_1fr] sm:gap-8">
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground sm:pt-1">Education</p>
            <div class="flex gap-5">
              <img src={education.logo} alt="" width="48" height="48" class="hidden h-12 w-12 flex-none rounded-lg object-cover sm:block" loading="lazy" />
              <div class="space-y-2">
                <h3 class="font-display text-2xl leading-tight sm:text-3xl">
                  {education.school}<span class="text-muted-foreground"> — {education.degree}</span>
                </h3>
                <p class="text-muted-foreground">{education.detail}</p>
              </div>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section id="projects" class="container-x scroll-mt-24 py-20 sm:py-28 border-t border-border">
    <SectionHeading index="02" label="Projects" title="Selected work" description="A few things I've shipped, plus an archive of earlier builds." />

    <div class="grid gap-6 sm:grid-cols-2" data-reveal-stagger>
      {featured.map((p) => {
        const primary = p.links[0];
        const Wrapper = primary ? "a" : "div";
        return (
          <article class="group card overflow-hidden">
            <Wrapper
              href={primary?.href}
              target={primary ? "_blank" : undefined}
              rel={primary ? "noopener noreferrer" : undefined}
              class="block"
            >
              <div class="relative aspect-[16/10] overflow-hidden bg-secondary">
                <img src={p.image} alt={p.title} class="img-zoom h-full w-full object-cover" loading="lazy" />
                <span class="absolute right-4 top-4 rounded-full bg-background/90 px-2.5 py-1 font-mono text-[11px] tracking-[0.12em] backdrop-blur">{p.year}</span>
              </div>
            </Wrapper>
            <div class="space-y-3 p-5 sm:p-6">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-center gap-3">
                  <img src={p.icon} alt="" width="36" height="36" class="h-9 w-9 rounded-md object-cover" loading="lazy" />
                  <h3 class="font-display text-2xl leading-none">{p.title}</h3>
                </div>
                {primary && (
                  <svg class="arrow mt-1 h-5 w-5 flex-none text-muted-foreground transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
                )}
              </div>
              <p class="text-sm text-muted-foreground">{p.description}</p>
              <div class="flex flex-wrap items-center gap-2 pt-1">
                {p.tags.map((t) => <span class="chip !py-1 text-xs">{t}</span>)}
                <span class="ml-auto flex gap-3">
                  {p.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer" class="link-underline font-mono text-[11px] uppercase tracking-[0.12em] text-muted-foreground hover:text-foreground">{l.label}</a>
                  ))}
                  {p.links.length === 0 && <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted-foreground/70">Private</span>}
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <details class="group mt-10" data-reveal>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 border-y border-border py-4 [&::-webkit-details-marker]:hidden">
        <span class="font-mono text-xs uppercase tracking-[0.14em] text-muted-foreground">Archive · {archive.length} earlier builds (2016–2019)</span>
        <span class="text-muted-foreground transition-transform duration-300 group-open:rotate-45">+</span>
      </summary>
      <ol class="divide-y divide-border">
        {archive.map((p, i) => (
          <li class="grid grid-cols-[2rem_1fr] items-center gap-4 py-4 sm:grid-cols-[2.5rem_2.5rem_1fr_auto_5rem]">
            <span class="font-mono text-xs text-muted-foreground">{String(i + 1).padStart(2, "0")}</span>
            <img src={p.icon} alt="" width="32" height="32" class="hidden h-8 w-8 rounded-md object-cover sm:block" loading="lazy" />
            <div>
              <h3 class="font-medium">{p.title}</h3>
              <p class="text-sm text-muted-foreground">{p.description}</p>
            </div>
            <div class="hidden gap-2 sm:flex">{p.tags.map((t) => <span class="chip !py-0.5 text-[11px]">{t}</span>)}</div>
            <span class="hidden text-right font-mono text-xs text-muted-foreground sm:block">{p.year}</span>
          </li>
        ))}
      </ol>
    </details>
  </section>

  <!-- ============ SKILLS + VALUES ============ -->
  <section class="container-x py-20 sm:py-28 border-t border-border">
    <div class="grid gap-14 lg:grid-cols-2">
      <div>
        <SectionHeading index="03" label="Skills" title="What I bring" />
        <ul class="flex flex-wrap gap-3" data-reveal-stagger>
          {skills.map((s) => (
            <li class="chip !px-4 !py-2.5 text-base">
              <img src={s.icon} alt="" width="28" height="28" class="h-7 w-7 object-contain" loading="lazy" />
              {s.label}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <SectionHeading index="04" label="Values" title="How I work" />
        <ul class="flex flex-wrap gap-3" data-reveal-stagger>
          {values.map((v) => (
            <li class="chip !px-4 !py-2.5 text-base">
              <img src={v.icon} alt="" width="28" height="28" class="h-7 w-7 object-contain" loading="lazy" />
              {v.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ REFERRALS ============ -->
  <section class="container-x py-20 sm:py-28 border-t border-border">
    <SectionHeading index="05" label="Referrals" title="In their words" description="People I've worked with who can speak to my strengths." />

    <div class="grid gap-6 md:grid-cols-2" data-reveal-stagger>
      {referees.map((r, i) => {
        const id = `ref-${i}`;
        return (
          <>
            <button type="button" data-open-dialog={id} class="group card relative p-6 text-left transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md sm:p-8">
              <span class="pointer-events-none absolute right-6 top-3 font-display text-7xl leading-none text-accent/25 transition-colors group-hover:text-accent/50" aria-hidden="true">”</span>
              <p class="line-clamp-4 pr-8 font-display text-xl leading-snug sm:text-2xl">{r.quote}</p>
              <div class="mt-6 flex items-center gap-4">
                <img src={r.image} alt="" width="44" height="44" class="h-11 w-11 rounded-full object-cover" loading="lazy" />
                <div>
                  <p class="font-medium">{r.name}</p>
                  <p class="text-sm text-muted-foreground">{r.position}</p>
                </div>
                <span class="ml-auto font-mono text-[11px] uppercase tracking-[0.12em] text-muted-foreground group-hover:text-foreground">Read →</span>
              </div>
            </button>

            <dialog id={id} data-dialog class="w-[min(92vw,44rem)] rounded-2xl border border-border bg-background p-0 text-foreground shadow-2xl">
              <div class="p-6 sm:p-8">
                <div class="flex items-start justify-between gap-4">
                  <div class="flex items-center gap-4">
                    <img src={r.image} alt="" width="48" height="48" class="h-12 w-12 rounded-full object-cover" />
                    <div>
                      <p class="font-medium">{r.name}</p>
                      <p class="text-sm text-muted-foreground">{r.position}</p>
                    </div>
                  </div>
                  <button type="button" data-close-dialog class="btn-ghost !px-3 !py-1.5 text-xs">Close</button>
                </div>
                <p class="mt-6 font-display text-xl leading-relaxed sm:text-2xl">“{r.quote}”</p>
              </div>
            </dialog>
          </>
        );
      })}
    </div>
  </section>

  <!-- ============ WRITING ============ -->
  <section class="container-x py-20 sm:py-28 border-t border-border">
    <SectionHeading index="06" label="Writing" title="Notes & essays" linkHref={site.substack} linkLabel="Substack" linkExternal />

    <ol class="divide-y divide-border border-y border-border" data-reveal-stagger>
      {posts.map((p) => (
        <li>
          <a href={`/blog/${p.slug}`} class="group grid items-baseline gap-2 py-5 sm:grid-cols-[8rem_1fr_auto] sm:gap-8">
            <time class="font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground" datetime={p.data.pubDate.toISOString()}>{fmtDate(p.data.pubDate)}</time>
            <div>
              <h3 class="font-display text-2xl leading-tight transition-colors group-hover:text-accent">{p.data.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{p.data.description}</p>
            </div>
            <span class="hidden text-muted-foreground transition-transform duration-300 group-hover:translate-x-1 sm:block">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ OFF THE CLOCK ============ -->
  <section class="container-x py-20 sm:py-28 border-t border-border">
    <SectionHeading index="07" label="Off the clock" title="Moments & music" linkHref="/gallery" linkLabel="Gallery" />

    <div class="grid items-start gap-6 lg:grid-cols-[1.6fr_1fr]">
      <div class="grid grid-cols-2 gap-4" data-reveal-stagger>
        {gallery.map((g) => (
          <a href="/gallery" class="group block">
            <div class="card aspect-[4/3] overflow-hidden">
              <img src={g.data.image} alt={g.data.alt ?? g.data.caption} class="img-zoom h-full w-full object-cover" loading="lazy" />
            </div>
            <p class="mt-2 text-sm">{g.data.caption} <span class="text-muted-foreground">· {fmtDate(g.data.date)}</span></p>
          </a>
        ))}
      </div>

      <div class="card overflow-hidden" data-reveal>
        <p class="eyebrow px-5 pt-5">On repeat</p>
        <iframe
          title="Spotify playlist"
          style="border-radius:12px"
          src="https://open.spotify.com/embed/playlist/6j5rNmQdrBG4WdLW86topD?utm_source=generator&theme=0"
          width="100%"
          height="352"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          class="mt-3"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="container-x scroll-mt-24 py-24 sm:py-32 border-t border-border">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow mb-6"><span class="text-accent">08</span> — Contact</p>
      <h2 class="font-display text-5xl leading-[0.95] sm:text-7xl">
        Wondering how we can build <em class="text-accent">the next big thing</em> together?
      </h2>
      <p class="mt-6 max-w-xl text-lg text-muted-foreground">
        I'm open to interesting problems in data, product, and infrastructure. Email is fastest.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={`mailto:${site.email}`} class="btn-primary">
          {site.email}
          <svg class="arrow h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
        <button type="button" data-copy={site.email} class="btn-ghost">
          <span data-copy-label>Copy email</span>
        </button>
        <a href={site.phoneHref} class="btn-ghost">{site.phone}</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      // Rotating role word
      const rot = document.querySelector("[data-rotator]");
      if (rot && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const words = Array.from(rot.children);
        let i = 0;
        setInterval(() => {
          const cur = words[i];
          i = (i + 1) % words.length;
          const next = words[i];
          cur.classList.remove("is-current");
          cur.classList.add("is-leaving");
          next.classList.add("is-current");
          setTimeout(() => cur.classList.remove("is-leaving"), 700);
        }, 2600);
      }

      // Dialogs
      document.addEventListener("click", (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        const open = t.closest("[data-open-dialog]");
        if (open) {
          const d = document.getElementById(open.getAttribute("data-open-dialog"));
          if (d instanceof HTMLDialogElement) d.showModal();
          return;
        }
        const close = t.closest("[data-close-dialog]");
        if (close) {
          const d = close.closest("dialog");
          if (d instanceof HTMLDialogElement) d.close();
        }
      });
      document.querySelectorAll("dialog[data-dialog]").forEach((d) => {
        d.addEventListener("click", (e) => { if (e.target === d) d.close(); });
      });

      // Copy email
      document.querySelectorAll("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const label = btn.querySelector("[data-copy-label]");
          try {
            await navigator.clipboard.writeText(btn.getAttribute("data-copy"));
            if (label) label.textContent = "Copied ✓";
          } catch {
            if (label) label.textContent = "Copy failed";
          }
          setTimeout(() => { if (label) label.textContent = "Copy email"; }, 1800);
        });
      });
    })();
  </script>
</Layout>
