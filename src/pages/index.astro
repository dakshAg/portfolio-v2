    dialog[data-referral-dialog]::backdrop { background: rgba(0, 0, 0, 0.55); }
    .substack-embeds :global(.substack-post-embed),
    .substack-embeds :global(iframe) {
      width: 100% !important;
      max-width: 100% !important;
    }
  </style>

  <script is:inline>
    (() => {
      const openDialog = (id) => {
        const el = document.getElementById(id);
        if (el && el instanceof HTMLDialogElement) el.showModal();
      };

      document.addEventListener("click", (e) => {
        const openBtn = e.target.closest("[data-open-dialog]");
        if (openBtn) {
          const id = openBtn.getAttribute("data-open-dialog");
          if (id) openDialog(id);
          return;
        }

        const closeBtn = e.target.closest("[data-close-dialog]");
        if (closeBtn) {
          const dlg = closeBtn.closest("dialog");
          if (dlg && dlg instanceof HTMLDialogElement) dlg.close();
        }
      });

      document.querySelectorAll("dialog[data-referral-dialog]").forEach((dlg) => {
        dlg.addEventListener("click", (e) => {
          if (e.target === dlg) dlg.close();
        });
      });

      // Live local time on the "Based in" chips
      document.querySelectorAll("[data-clock]").forEach((el) => {
        const time = el.querySelector("time");
        if (!time) return;
        const fmt = new Intl.DateTimeFormat("en-AU", {
          timeZone: el.getAttribute("data-clock"),
          hour: "numeric",
          minute: "2-digit",
        });
        const tick = () => {
          time.textContent = fmt.format(new Date());
          time.hidden = false;
        };
        tick();
        setInterval(tick, 30000);
      });
    })();
  </script>
</Layout>
