      <script is:inline>
        (() => {
          document.querySelectorAll(".substack-post-embed").forEach((element) => {
            const postLink = element.querySelector("[data-post-link]");
            if (!postLink) return;

            const href = postLink.getAttribute("href") || "";
            const match = href.match(/^(https?:\/\/[^/]+)\/p\/([^/?#]+)/);
            if (!match) return;

            const [, origin, slug] = match;
            const iframe = document.createElement("iframe");
            const frameURL = new URL(`${origin}/embed/p/${slug}`);
            frameURL.searchParams.set("origin", window.location.origin);
            frameURL.searchParams.set("fullURL", window.location.href);
            iframe.src = frameURL.toString();
            iframe.scrolling = "no";
            iframe.setAttribute("sandbox", "allow-scripts allow-same-origin allow-top-navigation allow-popups");
            iframe.setAttribute("allow", "clipboard-read clipboard-write");
            iframe.style.border = "none";
            iframe.style.display = "block";
            iframe.style.width = "100%";
            iframe.height = "470";
            iframe.title = postLink.textContent?.trim() || "Substack post";

            element.style.maxWidth = "100%";
            element.style.width = "100%";
            element.style.display = "block";

            window.addEventListener("message", (event) => {
              if (event.origin === origin && event.source === iframe.contentWindow && event.data?.iframeHeight) {
                iframe.height = event.data.iframeHeight;
              }
            });

            element.replaceChildren(iframe);
          });
        })();
      </script>
