                        action.variant === "primary"
                          ? "bg-primary text-primary-foreground hover:bg-primary/90"
                          : "bg-secondary text-secondary-foreground hover:bg-secondary/80";

                      return (
                        <a
                          href={action.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class={`${base} ${variantClass}`}
                        >
                          {action.label}
