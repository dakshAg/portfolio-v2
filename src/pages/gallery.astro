---
import Layout from "../layouts/main.astro";
import { getCollection } from "astro:content";

const items = (await getCollection("gallery"))
  .filter((i) => !i.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) => d.toLocaleDateString("en-AU", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title="Gallery — Daksh Agrawal" description="A small log of moments, screenshots, and things I've built.">
  <section class="container-x pt-16 pb-12 sm:pt-24">
    <p class="eyebrow fade-up mb-6" style="--d: 60ms">Gallery · {items.length} moments</p>
    <h1 class="font-display text-6xl leading-[0.95] sm:text-8xl">
      <span class="mask-line"><span style="--d: 120ms">A small log of</span></span>
      <span class="mask-line"><span style="--d: 240ms" class="text-muted-foreground">moments that mattered.</span></span>
    </h1>
  </section>

  <section class="container-x pb-24">
    <div class="columns-1 gap-6 sm:columns-2 lg:columns-3 [&>*]:mb-6 [&>*]:break-inside-avoid">
      {items.map((item) => (
        <figure class="group card overflow-hidden" data-reveal>
          <div class="overflow-hidden">
            <img
              src={item.data.image}
              alt={item.data.alt ?? item.data.caption}
              class="img-zoom w-full object-cover"
              loading="lazy"
            />
          </div>
          <figcaption class="flex items-baseline justify-between gap-4 p-4">
            <p class="font-medium">{item.data.caption}</p>
            <time class="font-mono text-[11px] uppercase tracking-[0.12em] text-muted-foreground" datetime={item.data.date.toISOString()}>
              {fmt(item.data.date)}
            </time>
          </figcaption>
        </figure>
      ))}
    </div>

    {items.length === 0 && (
      <p class="py-16 text-center text-muted-foreground">Nothing here yet.</p>
    )}
  </section>
</Layout>
